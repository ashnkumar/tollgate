{
  "name": "tollgate",
  "version": "0.1.0",
  "private": true,
  "description": "A marketplace of AI services billed per call, settled on-chain.",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "chain": "pnpm --filter @tollgate/contracts chain",
    "deploy": "pnpm --filter @tollgate/contracts deploy",
    "server": "pnpm --filter @tollgate/server start",
    "demo": "pnpm --filter @tollgate/demo start"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
