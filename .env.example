# Copy to .env only when you need to override something — the quickstart does not
# require this file, and `scripts/walkthrough.sh` sets what it needs itself.
#
# The server reads .env from the repo root at startup, on Node 20.12+. Real environment
# variables take precedence over anything written here.

# ── Model ───────────────────────────────────────────────────────────────────
# Required unless USE_FAKE_MODEL=true.
ANTHROPIC_API_KEY=

# Run against a deterministic fake instead of the Anthropic API: no key, no spend, and
# the whole payment path still exercised. Set false once you have a key.
USE_FAKE_MODEL=true

# ── Chain ───────────────────────────────────────────────────────────────────
# Any EVM endpoint. Defaults to the local Hardhat node.
RPC_URL=http://127.0.0.1:8545

# Written by `pnpm deploy:local`, read from deployment.json automatically.
# Set this to deploy or point at a contract somewhere else.
TOLLGATE_ADDRESS=

# The key the server signs settlements with. Must match the `settler` address the
# service was registered with. Falls back to the well-known Hardhat dev key when
# RPC_URL is local; required otherwise.
SETTLER_PRIVATE_KEY=

# Used by `hardhat run --network custom` to deploy somewhere other than localhost.
CHAIN_ID=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000

# Interface to bind. Loopback by default: /quote is unauthenticated and the process
# holds your API key, so exposing it should be deliberate. 0.0.0.0 for every interface.
HOST=127.0.0.1
